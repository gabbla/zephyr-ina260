config INA260
	bool "INA260 Current and Power Monitor"
	default y
	depends on DT_HAS_TI_INA260_ENABLED
	select I2C
	help
	  Enable driver for the INA260 Current and Power Monitor.

config INA260_TRIGGER
	bool "INA260 ALERT pin support"
	depends on INA260
	select GPIO
	help
	  Enable runtime threshold configuration and sensor triggers using the
	  ALERT pin. Callbacks execute on the system work queue. Set alert-gpios
	  in devicetree for each device that uses alerts.

config INA260_FAKE
	bool "Use FFF to simulate communication with INA260 sensor"
	default n
	depends on INA260
	select TEST
	help
	  Replaces the read register operation with a function that
	  returns static data readings

if INA260_FAKE
config TEST_LOGGING_DEFAULTS
	default n
endif
